{
  "name": "sri-lanka-history",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js application for Sri Lankan historical kingdoms and monarchs.",
  "scripts": {
    "dev": "HOST=127.0.0.1 PORT=3000 next dev",
    "dev:secure": "HOST=127.0.0.1 PORT=3000 NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "node scripts/check-no-google-fonts.js",
    "build": "next build && npm run postbuild",
    "postbuild": "node scripts/copy-cname.js",
    "start": "next start",
    "lint": "next lint",
    "test": "node scripts/verify-rotation.js",
    "validate": "node scripts/validate.js",
    "export:md": "node scripts/export-markdown.js output-md",
    "deploy": "next build && touch out/.nojekyll && git add -f out && git commit -m 'Deploy to GitHub Pages' && git subtree push --prefix out origin gh-pages",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sri-lanka",
    "history",
    "data",
    "kings",
    "kingdoms",
    "nextjs"
  ]
}
